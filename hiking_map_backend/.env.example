# 後端環境變數範本。複製成 .env 後填入實際值：
#   cp .env.example .env
# .env 已被 .gitignore 擋住，這個範本則會進版控——不要在這裡填真實值。

# --- 基本 ---
PORT=3001

# 資料庫（Neon）。從 Neon Console 的 Connection Details 取得
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# JWT 簽章密鑰。沒設定服務會直接啟動失敗（見 src/common/jwt-secret.ts），這是刻意的。
# 產一組：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 前端網址，用來組出密碼重設連結
FRONTEND_URL=http://localhost:4219

# --- 寄信（Gmail SMTP）---
# 沒設 MAIL_USER / MAIL_PASSWORD 時不會失敗，而是把整封信印在 log 裡，
# 本機因此不必真的寄信也能測完整的忘記密碼流程。
#
# MAIL_PASSWORD 要填「應用程式密碼」，不是你的 Gmail 登入密碼：
#   1. Google 帳戶 → 安全性 → 開啟兩步驟驗證（沒開就沒有這個選項）
#   2. 搜尋「應用程式密碼」，建立一組，會得到 16 碼
#   3. 把那 16 碼填在這裡（有無空格都可以）
#
# ⚠️ 部分部署平台會封鎖對外 SMTP port。若正式環境寄不出去而本機正常，多半是這個原因。
MAIL_USER=your-account@gmail.com
MAIL_PASSWORD=
# 寄件者顯示地址，留空則使用 MAIL_USER
MAIL_FROM=

# --- Google 登入 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Cloudflare R2（圖片與完整軌跡）---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
